{
  "name": "@statuz/statuz",
  "version": "0.5.0",
  "description": "Super package for Statuz - includes SDK, CLI, and MCP Server with smooth animations",
  "author": "ceaserzhao (Oasis Company)",
  "contributors": [
    {
      "name": "ceaserzhao",
      "url": "https://github.com/zbbsdsb",
      "organization": "Oasis Company"
    }
  ],
  "type": "module",
  "bin": {
    "statuz": "dist/index.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "validate:example": "tsx src/index.ts validate ../../examples/basic/statuz.yaml"
  },
  "dependencies": {
    "@statuz/cli": "^0.5.0",
    "@statuz/mcp-server": "^0.5.0",
    "@statuz/sdk-ts": "^0.5.0",
    "chalk": "^5.4.1",
    "cli-spinners": "^3.3.0",
    "commander": "^12.1.0",
    "figlet": "^1.9.0",
    "gradient-string": "^3.0.0",
    "ora": "^8.2.0",
    "yaml": "^2.7.0"
  },
  "devDependencies": {
    "@types/figlet": "^1.5.8",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/statuz-protocol/statuz.git",
    "directory": "packages/statuz"
  },
  "keywords": [
    "statuz",
    "ai-agent",
    "agent-status",
    "runtime-status",
    "agent-protocol",
    "sdk",
    "cli",
    "mcp"
  ],
  "bugs": {
    "url": "https://github.com/statuz-protocol/statuz/issues"
  },
  "homepage": "https://github.com/statuz-protocol/statuz#readme",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ]
}
