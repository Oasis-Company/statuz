{
  "name": "@statuz/cli",
  "version": "0.5.1",
  "description": "CLI for the Statuz AI Agent Runtime Status Protocol",
  "author": "ceaserzhao (Oasis Company)",
  "contributors": [
    {
      "name": "ceaserzhao",
      "url": "https://github.com/zbbsdsb",
      "organization": "Oasis Company"
    }
  ],
  "type": "module",
  "bin": {
    "statuz": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "validate:example": "tsx src/index.ts validate ../../examples/basic/statuz.yaml",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui"
  },
  "dependencies": {
    "@statuz/signal-bus": "file:../signal-bus",
    "commander": "^12.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.5",
    "yaml": "^2.9.0"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/statuz-protocol/statuz.git",
    "directory": "packages/cli"
  },
  "keywords": [
    "statuz",
    "ai-agent",
    "agent-status",
    "runtime-status",
    "agent-protocol",
    "cli"
  ],
  "bugs": {
    "url": "https://github.com/statuz-protocol/statuz/issues"
  },
  "homepage": "https://github.com/statuz-protocol/statuz#readme",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ]
}
