{
  "$id": "https://statuz.org/schemas/niche/niche-calibration.schema.json",
  "title": "niche Calibration Schema",
  "description": "JSON Schema for Statuz niche calibration - drift proposal",
  "type": "object",
  "required": [
    "calibration_version",
    "id",
    "timestamp",
    "evidence_window",
    "drift_analysis",
    "proposed_change",
    "evidence",
    "auto_triggers_syn"
  ],
  "properties": {
    "calibration_version": {
      "type": "string",
      "const": "1.0",
      "description": "Schema version, must be 1.0"
    },
    "id": {
      "type": "string",
      "pattern": "^cal-[0-9]{3}$",
      "description": "Unique calibration ID (e.g., cal-001)"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "When the calibration was generated"
    },
    "evidence_window": {
      "type": "object",
      "required": ["start", "end"],
      "properties": {
        "start": {
          "type": "string",
          "format": "date-time"
        },
        "end": {
          "type": "string",
          "format": "date-time"
        }
      },
      "description": "Time window for evidence collection"
    },
    "drift_analysis": {
      "type": "object",
      "required": ["task_drift", "collaboration_drift", "boundary_drift"],
      "properties": {
        "task_drift": {
          "type": "object",
          "required": ["metric", "observed", "threshold", "description"],
          "properties": {
            "metric": {
              "type": "string"
            },
            "observed": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "threshold": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "description": {
              "type": "string"
            }
          }
        },
        "collaboration_drift": {
          "type": "object",
          "required": ["metric", "observed", "threshold", "description"],
          "properties": {
            "metric": {
              "type": "string"
            },
            "observed": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "threshold": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "description": {
              "type": "string"
            }
          }
        },
        "boundary_drift": {
          "type": "object",
          "required": ["metric", "observed", "threshold", "description"],
          "properties": {
            "metric": {
              "type": "string"
            },
            "observed": {
              "type": "number"
            },
            "threshold": {
              "type": "number"
            },
            "description": {
              "type": "string"
            }
          }
        }
      },
      "description": "Analysis of position drift across three dimensions"
    },
    "proposed_change": {
      "type": "object",
      "required": ["type", "description"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["update_declared_position", "maintain_position", "reassign_responsibility"]
        },
        "description": {
          "type": "string"
        },
        "rationale": {
          "type": "string"
        }
      },
      "description": "Proposed calibration action"
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "IDs of outcome records used as evidence"
    },
    "auto_triggers_syn": {
      "type": "boolean",
      "description": "Whether this calibration automatically triggers SYN"
    },
    "recommendations": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Alternative options to consider"
    },
    "syn_request_id": {
      "type": "string",
      "description": "ID of SYN request if triggered"
    }
  },
  "additionalProperties": true
}
